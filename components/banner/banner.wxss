.banner-wrap {
  position: relative;
  width: 100%;
}

.banner-swiper {
  width: 100%;
  height: 420rpx;
}

.banner-slide {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.banner-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.banner-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  font-size: var(--font-sm);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  width: fit-content;
  backdrop-filter: blur(10rpx);
}

.banner-title {
  font-size: var(--font-xxl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  line-height: 1.2;
}

.banner-subtitle {
  font-size: var(--font-md);
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
}

.banner-cta {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  color: #FF6B35;
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  width: fit-content;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
}

.banner-cta:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.banner-decor {
  position: absolute;
  right: -40rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}

.decor-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.decor-1 {
  width: 240rpx;
  height: 240rpx;
  top: -120rpx;
  right: 0;
}

.decor-2 {
  width: 160rpx;
  height: 160rpx;
  top: 40rpx;
  right: 80rpx;
}

.decor-paw {
  font-size: 100rpx;
  position: absolute;
  top: -30rpx;
  right: 20rpx;
  opacity: 0.3;
}

.banner-counter {
  position: absolute;
  bottom: 24rpx;
  right: 32rpx;
  background: rgba(0, 0, 0, 0.25);
  color: #FFFFFF;
  font-size: var(--font-xs);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  z-index: 3;
}

.counter-divider {
  margin: 0 4rpx;
  opacity: 0.6;
}
