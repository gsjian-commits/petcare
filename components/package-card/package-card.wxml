<scroll-view class="package-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
  <view class="package-list">
    <view
      class="package-card"
      wx:for="{{packages}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapPackage"
    >
      <view class="card-tag" style="background-color: {{item.tagColor}}" wx:if="{{item.tag}}">
        {{item.tag}}
      </view>
      <view class="card-header">
        <text class="card-name">{{item.name}}</text>
        <text class="card-desc">{{item.desc}}</text>
      </view>
      <view class="card-price">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{item.price}}</text>
        <text class="price-period">/{{item.period}}</text>
        <text class="price-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
      </view>
      <view class="card-features">
        <view class="feature-item" wx:for="{{item.features}}" wx:for-item="feature" wx:key="*this">
          <text class="feature-dot">·</text>
          <text class="feature-text">{{feature}}</text>
        </view>
      </view>
      <view class="card-action">
        <text>立即开通</text>
        <text class="action-arrow">→</text>
      </view>
    </view>
    <view class="scroll-spacer"></view>
  </view>
</scroll-view>
