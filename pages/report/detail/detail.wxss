.page-report {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* 加载 */
.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-hint);
}

/* 报告头部 */
.report-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
}

.header-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: var(--font-xxl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.header-date {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 公共区块 */
.report-section {
  background: var(--color-bg-card);
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

/* 信息网格 */
.info-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.info-item-label {
  width: 140rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
  flex-shrink: 0;
}

.info-item-value {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.staff-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.staff-avatar {
  font-size: var(--font-lg);
}

.staff-name {
  font-size: var(--font-md);
  color: var(--text-primary);
}

.rating-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: var(--font-lg);
  color: var(--color-border);
}

.star-active {
  color: #FFD700;
}

/* 照片区域 */
.photo-grid {
  display: flex;
  gap: 16rpx;
}

.photo-placeholder {
  flex: 1;
  aspect-ratio: 1;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-after {
  background: var(--color-primary-bg);
  border-color: rgba(255, 107, 53, 0.2);
}

.placeholder-icon {
  font-size: 40rpx;
}

.placeholder-text {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

/* 标签 */
.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 8rpx 24rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: var(--font-sm);
  border-radius: 20rpx;
}

/* 文本内容 */
.report-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-line;
}

.report-suggestions {
  color: var(--color-primary-dark);
  background: var(--color-primary-bg);
  padding: 20rpx;
  border-radius: var(--radius-md);
  display: block;
}

/* 再次预约 */
.rebook-area {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rebook-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.rebook-btn {
  padding: 14rpx 40rpx;
  background: var(--color-primary);
  border-radius: var(--radius-xl);
}

.rebook-btn text {
  font-size: var(--font-md);
  color: #FFFFFF;
  font-weight: var(--weight-medium);
}

/* 底部安全区 */
.bottom-safe-area {
  height: 40rpx;
}
