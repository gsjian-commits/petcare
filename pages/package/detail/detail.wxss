.page-package-detail {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 140rpx;
}

/* ===== 1. Hero 卡片 ===== */
.package-hero {
  margin: 24rpx 24rpx 0;
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.hero-back {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 2;
}

.hero-back-btn {
  font-size: var(--font-md);
  color: rgba(255, 255, 255, 0.9);
  font-weight: var(--weight-medium);
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-md);
}

.hero-back-btn:active {
  opacity: 0.7;
}

.hero-deco {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.hero-deco-text {
  position: absolute;
  color: rgba(255, 255, 255, 0.08);
  font-size: 120rpx;
}

.deco-1 {
  top: -20rpx;
  right: -20rpx;
}

.deco-2 {
  bottom: 0rpx;
  left: 40rpx;
  font-size: 80rpx;
}

.hero-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.3);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.hero-tag-text {
  font-size: var(--font-xs);
  color: #FFFFFF;
  font-weight: var(--weight-medium);
}

.hero-name {
  font-size: var(--font-xxl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.hero-desc {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.hero-price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.hero-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.hero-price-symbol {
  font-size: var(--font-lg);
  color: #FFFFFF;
  font-weight: var(--weight-bold);
}

.hero-price-value {
  font-size: 80rpx;
  color: #FFFFFF;
  font-weight: var(--weight-bold);
  line-height: 1;
}

.hero-price-period {
  font-size: var(--font-md);
  color: rgba(255, 255, 255, 0.75);
}

.hero-price-original {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.6);
  text-decoration: line-through;
}

/* ===== 通用区块 ===== */
.detail-section {
  background: var(--color-bg-card);
  margin: 20rpx 24rpx;
  padding: 28rpx 28rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.section-title-icon {
  font-size: var(--font-md);
  margin-right: 8rpx;
}

/* ===== 2. 特性网格 ===== */
.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 16rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
}

.feature-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-round);
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-label {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

/* ===== 3. 服务清单 ===== */
.checklist {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checklist-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checklist-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-round);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #FFFFFF;
  font-size: var(--font-xs);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checklist-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ===== 4. 购买须知 ===== */
.notes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #FFF8F0;
  padding: 24rpx;
  border-radius: var(--radius-md);
  border-left: 6rpx solid var(--color-warning);
}

.notes-item {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.notes-dot {
  font-size: var(--font-md);
  color: var(--color-primary);
  flex-shrink: 0;
}

.notes-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ===== 5. FAQ 手风琴 ===== */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.faq-item {
  border-bottom: 2rpx solid var(--color-divider);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  cursor: pointer;
}

.faq-question:active {
  opacity: 0.7;
}

.faq-q-text {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
  flex: 1;
}

.faq-arrow {
  font-size: 36rpx;
  color: var(--text-placeholder);
  transition: transform var(--transition-fast);
  margin-left: 16rpx;
}

.faq-arrow-open {
  transform: rotate(90deg);
  color: var(--color-primary);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-normal), padding var(--transition-normal);
}

.faq-answer-open {
  max-height: 300rpx;
  padding-bottom: 24rpx;
}

.faq-a-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.7;
  display: block;
}

/* ===== 6. 底部固定操作栏 ===== */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.action-price-label {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-right: 8rpx;
}

.action-price-symbol {
  font-size: var(--font-md);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

.action-price-value {
  font-size: var(--font-xxl);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
  line-height: 1;
}

.action-price-period {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: var(--text-inverse);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  padding: 20rpx 60rpx;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.action-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ===== 底部安全区 ===== */
.bottom-safe-area {
  height: 40rpx;
}
