.page-order-detail {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* 加载 */
.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-hint);
}

/* 状态区域 */
.status-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
}

.status-bg-pending_payment {
  background: linear-gradient(135deg, #FFF4EF 0%, #FEF5E7 100%);
}

.status-bg-pending_service {
  background: linear-gradient(135deg, #EBF5FB 0%, #EDFAF9 100%);
}

.status-bg-in_progress {
  background: linear-gradient(135deg, #FFF4EF 0%, #FFE8D6 100%);
}

.status-bg-completed {
  background: linear-gradient(135deg, #E8F8F0 0%, #D5F5E3 100%);
}

.status-bg-cancelled {
  background: var(--color-divider);
}

.status-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.status-icon {
  font-size: 48rpx;
}

.status-text {
  font-size: var(--font-xxl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.status-hint {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  text-align: center;
}

/* 公共区块 */
.od-section {
  background: var(--color-bg-card);
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.od-section-header {
  margin-bottom: 20rpx;
}

.od-section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

/* 服务信息卡片 */
.service-info-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.service-info-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-info-icon text {
  font-size: 40rpx;
}

.service-info-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.service-info-name {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.service-info-pet {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

/* 管家信息 */
.staff-info-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.staff-info-avatar {
  font-size: 44rpx;
}

.staff-info-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.staff-info-name {
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
}

.staff-info-label {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.staff-info-contact {
  padding: 12rpx 24rpx;
  background: var(--color-primary-bg);
  border-radius: var(--radius-xl);
}

.staff-info-contact text {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 详情行 */
.detail-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-row {
  display: flex;
}

.detail-label {
  width: 140rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.detail-address {
  line-height: 1.6;
}

/* 价格明细 */
.price-rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-label {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.price-value {
  font-size: var(--font-md);
  color: var(--text-primary);
}

.price-discount {
  color: var(--color-success);
}

.price-divider {
  height: 1rpx;
  background: var(--color-divider);
}

.price-total .price-label {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.total-symbol {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: var(--weight-semibold);
}

.total-amount {
  font-size: var(--font-xxl);
  font-weight: var(--weight-bold);
  color: var(--color-primary);
}

/* 操作按钮 */
.action-section {
  padding: 0 24rpx;
  margin-top: 8rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-xl);
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
}

.action-btn-primary {
  background: var(--color-primary);
  color: #FFFFFF;
}

.action-btn-secondary {
  background: var(--color-bg-card);
  color: var(--text-secondary);
  border: 1rpx solid var(--color-border);
}

/* 底部安全区 */
.bottom-safe-area {
  height: 40rpx;
}
