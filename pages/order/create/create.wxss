.page-order-create {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 140rpx;
}

.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-hint);
}

/* ===== 通用区块 ===== */
.oc-section {
  background: var(--color-bg-card);
  margin: 20rpx 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.oc-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.oc-section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.oc-section-action text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: var(--weight-medium);
}

/* ===== 1. 服务信息 ===== */
.service-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.service-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.service-icon text {
  font-size: 56rpx;
}

.service-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.service-name {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.service-duration {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.service-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.price-symbol {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

.price-value {
  font-size: var(--font-xl);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

/* ===== 2. 宠物选择 ===== */
.no-pets {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.no-pets-icon {
  font-size: 64rpx;
}

.no-pets-text {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.no-pets-btn {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: var(--weight-medium);
  padding: 12rpx 36rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--color-primary);
  margin-top: 8rpx;
}

.no-pets-btn:active {
  background: var(--color-primary-bg);
}

.pet-select-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pet-select-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  transition: all 0.15s ease;
}

.pet-select-item:active {
  border-color: var(--color-primary);
}

.pet-select-active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

.pet-select-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pet-select-avatar text {
  font-size: 40rpx;
}

.pet-select-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pet-select-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.pet-select-breed {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.pet-select-check {
  margin-left: auto;
}

.check-icon {
  font-size: var(--font-xl);
  color: var(--text-placeholder);
}

.check-icon-active {
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

/* ===== 3. 日期选择 ===== */
.date-grid {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 4rpx 0;
}

.date-grid::-webkit-scrollbar {
  display: none;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 88rpx;
  padding: 16rpx 8rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  gap: 6rpx;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.date-item:active {
  transform: scale(0.95);
}

.date-disabled {
  opacity: 0.4;
}

.date-selected {
  background: var(--color-primary);
}

.date-selected .date-weekday,
.date-selected .date-day {
  color: var(--text-inverse);
}

.date-weekday {
  font-size: 20rpx;
  color: var(--text-hint);
}

.date-day {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

.date-indicator {
  margin-top: 4rpx;
}

.date-today {
  font-size: 18rpx;
  color: var(--color-primary);
  font-weight: var(--weight-medium);
}

.date-full {
  font-size: 18rpx;
  color: var(--text-placeholder);
}

/* ===== 4. 时段选择 ===== */
.time-grid {
  display: flex;
  gap: 16rpx;
}

.time-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  gap: 6rpx;
  transition: all 0.15s ease;
}

.time-item:active {
  border-color: var(--color-primary);
}

.time-selected {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

.time-selected .time-label {
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

.time-label {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.time-range {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

/* ===== 5. 地址选择 ===== */
.no-address {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.no-address-text {
  font-size: var(--font-md);
  color: var(--text-placeholder);
}

.address-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border);
  margin-top: 12rpx;
  transition: all 0.15s ease;
}

.address-item:active {
  border-color: var(--color-primary);
}

.address-active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

.address-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.address-tags {
  display: flex;
  gap: 8rpx;
}

.address-tag-default {
  font-size: 18rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-primary);
}

.address-detail {
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.5;
}

.address-user {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.address-check {
  margin-left: 16rpx;
  padding-top: 4rpx;
}

/* ===== 6. 优惠券 ===== */
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.coupon-tip {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: var(--weight-medium);
}

.coupon-tip-empty {
  color: var(--text-placeholder);
  font-weight: var(--weight-normal);
}

/* ===== 7. 备注 ===== */
.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  line-height: 1.5;
}

.remark-counter {
  display: block;
  text-align: right;
  font-size: var(--font-xs);
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* ===== 8. 价格明细 ===== */
.price-summary-section {
  margin-bottom: 24rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.price-row-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.price-row-value {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
}

.price-row-discount {
  color: var(--color-danger);
}

.price-total-row {
  border-top: 2rpx solid var(--color-border);
  padding-top: 20rpx;
  margin-top: 8rpx;
}

.price-total {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.price-total-symbol {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

.price-total-value {
  font-size: var(--font-xxl);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bottom-bar-left {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.bottom-price-label {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-right: 4rpx;
}

.bottom-price-symbol {
  font-size: var(--font-md);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
}

.bottom-price-value {
  font-size: var(--font-xxl);
  color: var(--color-primary);
  font-weight: var(--weight-bold);
  line-height: 1;
}

.bottom-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: var(--text-inverse);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  padding: 20rpx 56rpx;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.bottom-submit:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.bottom-submit-disabled {
  opacity: 0.5;
}

/* ===== 底部安全区域 ===== */
.bottom-safe-area {
  height: 40rpx;
}