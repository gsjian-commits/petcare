<view class="page-user">
  <!-- 1. 用户信息头部 -->
  <view class="user-header">
    <view class="user-info">
      <view class="user-avatar">
        <text class="avatar-icon">{{userInfo.avatar}}</text>
      </view>
      <view class="user-meta">
        <text class="user-nickname">{{userInfo.nickname}}</text>
        <view class="user-member" bindtap="goMember">
          <text class="member-icon">{{userInfo.memberCard}}</text>
          <text class="member-text">{{userInfo.memberLevel}}</text>
          <text class="member-arrow">›</text>
        </view>
      </view>
    </view>
    <view class="user-extra">
      <text class="extra-label">剩余服务次数</text>
      <text class="extra-count">{{userInfo.remainingServiceCount}}</text>
      <text class="extra-unit">次</text>
    </view>
  </view>

  <!-- 2. 订单快捷入口 -->
  <view class="order-stats" bindtap="goOrders">
    <view class="order-stat-item">
      <text class="stat-count">{{userInfo.orderCounts.pendingPayment}}</text>
      <text class="stat-label">待支付</text>
    </view>
    <view class="stat-divider"></view>
    <view class="order-stat-item">
      <text class="stat-count">{{userInfo.orderCounts.inProgress}}</text>
      <text class="stat-label">进行中</text>
    </view>
    <view class="stat-divider"></view>
    <view class="order-stat-item">
      <text class="stat-count">{{userInfo.orderCounts.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-divider"></view>
    <view class="order-stat-item">
      <text class="stat-count">{{userInfo.orderCounts.pendingService}}</text>
      <text class="stat-label">待服务</text>
    </view>
    <view class="stat-arrow">›</view>
  </view>

  <!-- 3. 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goOrders">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPets">
      <text class="menu-icon">🐾</text>
      <text class="menu-text">宠物档案</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMember">
      <text class="menu-icon">🥇</text>
      <text class="menu-text">我的会员</text>
      <view class="menu-tag" wx:if="{{userInfo.memberLevel}}">
        <text class="menu-tag-text">{{userInfo.memberLevel}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goReports">
      <text class="menu-icon">📄</text>
      <text class="menu-text">服务报告</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCoupons">
      <text class="menu-icon">🎫</text>
      <text class="menu-text">优惠券</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAddresses">
      <text class="menu-icon">📍</text>
      <text class="menu-text">地址管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 4. 联系我们 & 设置 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="contactService">
      <text class="menu-icon">💬</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-hint">在线时间 9:00-21:00</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="bottom-safe-area"></view>
</view>
