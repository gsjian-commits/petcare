.page-coupons {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* Tab */
.coupon-tabs {
  display: flex;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
}

.coupon-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  position: relative;
}

.coupon-tab-active .tab-text {
  color: var(--color-primary);
  font-weight: var(--weight-semibold);
}

.coupon-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.tab-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.tab-count {
  font-size: var(--font-xs);
  color: #FFFFFF;
  background: var(--color-primary);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  min-width: 28rpx;
  text-align: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-md);
  border-radius: var(--radius-xl);
}

/* 优惠券列表 */
.coupon-list {
  padding: 24rpx 24rpx 0;
}

.coupon-card {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  min-height: 180rpx;
}

.coupon-disabled {
  opacity: 0.6;
}

/* 左侧金额区 */
.coupon-left {
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  position: relative;
}

.coupon-disabled .coupon-left {
  background: linear-gradient(135deg, #B0B0B0 0%, #CCCCCC 100%);
}

.coupon-amount {
  display: flex;
  align-items: baseline;
}

.coupon-symbol {
  font-size: var(--font-sm);
  color: #FFFFFF;
  font-weight: var(--weight-bold);
}

.coupon-value {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: var(--weight-bold);
  line-height: 1.1;
}

.coupon-unit {
  font-size: var(--font-xl);
  color: #FFFFFF;
  font-weight: var(--weight-bold);
}

.coupon-condition {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  text-align: center;
}

/* 中间分割线 */
.coupon-divider {
  width: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  position: relative;
}

.divider-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-bg-page);
  position: absolute;
}

.top-dot {
  top: -8rpx;
}

.bottom-dot {
  bottom: -8rpx;
}

.divider-line {
  width: 2rpx;
  flex: 1;
  background: var(--color-divider);
  border-left: 2rpx dashed var(--color-border);
}

/* 右侧信息区 */
.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 24rpx 24rpx 16rpx;
  gap: 8rpx;
  position: relative;
}

.coupon-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.coupon-expire {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.coupon-status-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: var(--color-divider);
}

.badge-expired {
  background: #FDEDEC;
}

.badge-text {
  font-size: var(--font-xs);
  color: var(--text-hint);
}

.badge-expired .badge-text {
  color: var(--color-danger);
}

.coupon-use-btn {
  align-self: flex-end;
  padding: 8rpx 28rpx;
  background: var(--color-primary);
  border-radius: var(--radius-xl);
  margin-top: 4rpx;
}

.coupon-use-btn text {
  font-size: var(--font-sm);
  color: #FFFFFF;
}

/* 底部安全区 */
.bottom-safe-area {
  height: 40rpx;
}
