.page-orders {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* 状态Tab */
.order-tabs {
  display: flex;
  background: var(--color-bg-card);
  padding: 0 16rpx;
  border-bottom: 1rpx solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 10;
  overflow-x: auto;
  white-space: nowrap;
}

.order-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx;
  gap: 8rpx;
  position: relative;
}

.tab-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.order-tab-active .tab-text {
  color: var(--color-primary);
  font-weight: var(--weight-semibold);
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 16rpx 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-md);
  border-radius: var(--radius-xl);
}

/* 订单卡片 */
.order-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.order-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 0;
}

.card-service-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-service-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-service-icon text {
  font-size: 32rpx;
}

.card-service-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-service-name {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.card-pet-name {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.card-status {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.card-status-pending_payment {
  color: var(--color-warning);
  background: #FEF5E7;
}

.card-status-pending_service {
  color: var(--color-info);
  background: #EBF5FB;
}

.card-status-in_progress {
  color: var(--color-primary);
  background: var(--color-primary-bg);
}

.card-status-completed {
  color: var(--color-success);
  background: #E8F8F0;
}

.card-status-cancelled {
  color: var(--text-hint);
  background: var(--color-divider);
}

.order-card-body {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.card-info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.card-info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 120rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.info-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}

.card-amount {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.amount-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.amount-symbol {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: var(--weight-semibold);
}

.amount-value {
  font-size: var(--font-xl);
  color: var(--text-primary);
  font-weight: var(--weight-bold);
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.card-action {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-xl);
  font-size: var(--font-sm);
}

.action-primary {
  background: var(--color-primary);
  color: #FFFFFF;
}

.action-default {
  background: var(--color-bg-page);
  color: var(--text-secondary);
  border: 1rpx solid var(--color-border);
}

/* 加载 */
.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: var(--font-md);
  color: var(--text-hint);
}

/* 底部安全区 */
.bottom-safe-area {
  height: 40rpx;
}
