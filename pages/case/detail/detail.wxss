.page-case-detail {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding-bottom: 40rpx;
}

/* ===== 1. 头部区域 ===== */
.case-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.header-back {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  z-index: 2;
}

.header-back-btn {
  font-size: var(--font-md);
  color: var(--text-inverse);
  font-weight: var(--weight-medium);
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-md);
}

.header-back-btn:active {
  opacity: 0.7;
}

.header-avatar {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  display: block;
}

.header-title {
  font-size: var(--font-xxl);
  font-weight: var(--weight-bold);
  color: var(--text-inverse);
  text-align: center;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.header-tags {
  display: flex;
  gap: 12rpx;
}

.header-tag {
  font-size: var(--font-xs);
  color: var(--text-inverse);
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: var(--weight-medium);
}

/* ===== 通用区块 ===== */
.detail-section {
  background: var(--color-bg-card);
  margin: 20rpx 24rpx;
  padding: 28rpx 28rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
}

/* ===== 2. 服务流程（时间线） ===== */
.process-timeline {
  display: flex;
  flex-direction: column;
}

.process-item {
  display: flex;
  gap: 24rpx;
  min-height: 100rpx;
}

.process-dot-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 48rpx;
  flex-shrink: 0;
}

.process-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-round);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: var(--text-inverse);
  font-size: var(--font-sm);
  font-weight: var(--weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.process-line {
  width: 4rpx;
  flex: 1;
  background: linear-gradient(to bottom, var(--color-primary) 0%, rgba(255, 107, 53, 0.15) 100%);
  min-height: 40rpx;
}

.process-content {
  flex: 1;
  background: var(--color-bg-page);
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
}

.process-title {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.process-desc {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
}

/* ===== 3. 详情段落 ===== */
.detail-paragraphs {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-paragraph {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.8;
}

/* ===== 4. 亮点 ===== */
.highlights-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.highlight-item {
  display: flex;
  align-items: center;
  background: var(--color-primary-bg);
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  border-left: 6rpx solid var(--color-primary);
}

.highlight-text {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: var(--weight-medium);
  line-height: 1.5;
}

/* ===== 5. 评价 ===== */
.review-body {
  background: var(--color-bg-page);
  padding: 24rpx;
  border-radius: var(--radius-md);
}

.review-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.review-avatar {
  font-size: 48rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.review-name {
  font-size: var(--font-md);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
}

.review-stars {
  font-size: var(--font-xs);
}

.review-content {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.7;
  display: block;
}

/* ===== 6. 相关服务 ===== */
.related-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.related-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  gap: 16rpx;
  cursor: pointer;
  transition: border-color var(--transition-fast);
}

.related-item:active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

.related-icon {
  font-size: 40rpx;
}

.related-name {
  flex: 1;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
}

.related-arrow {
  font-size: var(--font-lg);
  color: var(--text-placeholder);
}

/* ===== 底部安全区 ===== */
.bottom-safe-area {
  height: 40rpx;
}
