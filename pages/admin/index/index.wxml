<view class="page-admin">
  <!-- 顶部导航 -->
  <view class="admin-header">
    <view class="header-top">
      <text class="header-back" bindtap="goBack">‹ 返回</text>
      <text class="header-title">管理后台</text>
      <text class="header-placeholder"></text>
    </view>
  </view>

  <!-- 仪表盘卡片 -->
  <view class="dashboard-row">
    <view class="dashboard-card card-orange">
      <text class="card-label">今日订单</text>
      <text class="card-value">{{stats.todayOrders}}</text>
      <text class="card-unit">单</text>
    </view>
    <view class="dashboard-card card-blue">
      <text class="card-label">待处理</text>
      <text class="card-value">{{stats.pendingCount}}</text>
      <text class="card-unit">单</text>
    </view>
    <view class="dashboard-card card-green">
      <text class="card-label">今日收入</text>
      <text class="card-value">{{stats.todayIncome}}</text>
      <text class="card-unit">元</text>
    </view>
  </view>

  <!-- Tab 筛选 -->
  <view class="filter-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="filter-tab {{currentTab === item.key ? 'filter-tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
    >
      <view class="order-header">
        <view class="order-id-row">
          <text class="order-id-label">订单号</text>
          <text class="order-id">{{item.id}}</text>
        </view>
        <view class="order-status-badge status-{{item.status}}">
          <text>{{item.statusLabel}}</text>
        </view>
      </view>

      <view class="order-body">
        <view class="order-info-row">
          <text class="info-icon">{{item.serviceIcon}}</text>
          <text class="info-service">{{item.serviceName}}</text>
        </view>
        <view class="order-info-row">
          <text class="info-label">客户</text>
          <text class="info-value">铲屎官小李</text>
        </view>
        <view class="order-info-row">
          <text class="info-label">宠物</text>
          <text class="info-value">{{item.petName}}</text>
        </view>
        <view class="order-info-row">
          <text class="info-label">时间</text>
          <text class="info-value">{{item.date}} {{item.timeLabel}}</text>
        </view>
        <view class="order-info-row">
          <text class="info-label">地址</text>
          <text class="info-value info-address">{{item.address}}</text>
        </view>
        <view class="order-divider"></view>
        <view class="order-amount-row">
          <text class="amount-label">订单金额</text>
          <text class="amount-value">¥{{item.amount}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" wx:if="{{item.status === 'pending_service' || item.status === 'in_progress'}}">
        <view class="action-btn btn-confirm" wx:if="{{item.status === 'pending_service'}}" data-id="{{item.id}}" bindtap="confirmOrder">
          <text>确认接单</text>
        </view>
        <view class="action-btn btn-complete" wx:if="{{item.status === 'in_progress'}}" data-id="{{item.id}}" bindtap="completeOrder">
          <text>完成服务</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无相关订单</text>
  </view>

  <!-- 底部安全区 -->
  <view class="bottom-safe"></view>
</view>
