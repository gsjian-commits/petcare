.page-admin {
  min-height: 100vh;
  background-color: #F5F6FA;
  padding-bottom: 40rpx;
}

/* 顶部导航 */
.admin-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  padding: 88rpx 32rpx 40rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-back {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  padding: 8rpx 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.header-placeholder {
  width: 100rpx;
}

/* 仪表盘 */
.dashboard-row {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-top: -32rpx;
}

.dashboard-card {
  flex: 1;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.card-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  display: block;
}

.card-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: inline-block;
  margin-top: 8rpx;
}

.card-unit {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-left: 4rpx;
  display: inline-block;
}

.card-orange {
  background: linear-gradient(135deg, #FF6B35, #FF9A5C);
}

.card-blue {
  background: linear-gradient(135deg, #4A90D9, #6FB1FC);
}

.card-green {
  background: linear-gradient(135deg, #34C759, #6EE79A);
}

/* Tab 筛选 */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  padding: 32rpx 32rpx 0;
}

.filter-tab {
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.filter-tab-active {
  background: #FF6B35;
  color: #FFFFFF;
  font-weight: 600;
}

/* 订单列表 */
.order-list {
  padding: 24rpx 32rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-id-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-id-label {
  font-size: 22rpx;
  color: #999;
}

.order-id {
  font-size: 22rpx;
  color: #666;
  font-family: monospace;
}

.order-status-badge {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-pending_payment {
  background: #FFF4EF;
  color: #FF6B35;
}

.status-pending_service {
  background: #FFF4EF;
  color: #FF6B35;
}

.status-in_progress {
  background: #EBF5FB;
  color: #4A90D9;
}

.status-completed {
  background: #EDFAF5;
  color: #34C759;
}

.status-cancelled {
  background: #F5F5F5;
  color: #999;
}

/* 订单信息 */
.order-body {
  margin-bottom: 12rpx;
}

.order-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.info-icon {
  font-size: 32rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-service {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 60rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #444;
  flex: 1;
}

.info-address {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 16rpx 0;
}

.order-amount-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.amount-label {
  font-size: 24rpx;
  color: #999;
}

.amount-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B35;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-confirm {
  background: #FF6B35;
  color: #FFFFFF;
}

.btn-complete {
  background: #34C759;
  color: #FFFFFF;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部安全区 */
.bottom-safe {
  height: 40rpx;
}
